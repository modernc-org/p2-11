import (
	"testing"

	"modernc.org/p2-11/mac"
	"modernc.org/p2-11/pdp11"
)

// The line by itself, this test being the three cogs in turn, and then the
// line as the console of a machine that runs a program.

const at = 0o177560

var (
	line    Line
	machine pdp11.Machine
	output  [512]byte
)

// expect fails the test unless got is want.
func expect(t *testing.T, what string, got, want uint16) {
	if got != want {
		printf("%s %06o, want %06o\n", what, got, want)
		t.Fail()
	}
}

func TestReceive(t *testing.T) {
	line.Reset()
	expect(t, "receiver status after a reset", line.Read(at+rcsr), 0)
	expect(t, "the request after a reset", line.Request(), 0)

	line.Put('A')
	line.Put('B')
	expect(t, "receiver status, a byte having arrived", line.Read(at+rcsr), done)
	expect(t, "the request, interrupts not being enabled", line.Request(), 0)

	// Enabling them while there is a byte requests one at once.
	line.Write(at+rcsr, enable, 0xffff)
	expect(t, "receiver status, enabled", line.Read(at+rcsr), done|enable)
	expect(t, "the request", line.Request(), 0o060)
	line.Granted(0o060)
	expect(t, "the request, granted", line.Request(), 0)
	expect(t, "receiver status, the interrupt taken", line.Read(at+rcsr), done|enable)

	// Reading the byte makes room for the next, which requests its own.
	expect(t, "the first byte", line.Read(at+rbuf), 'A')
	expect(t, "the request for the second", line.Request(), 0o060)
	expect(t, "the second byte", line.Read(at+rbuf), 'B')
	expect(t, "the request, the second byte read", line.Request(), 0)
	expect(t, "receiver status, nothing left", line.Read(at+rcsr), enable)

	// Disabling interrupts withdraws the request.
	line.Put('C')
	expect(t, "the request for the third", line.Request(), 0o060)
	line.Write(at+rcsr, 0, 0x00ff)
	expect(t, "the request, disabled", line.Request(), 0)
	expect(t, "the third byte", line.Read(at+rbuf), 'C')

	// The upper byte of the register has nothing to write.
	line.Write(at+rcsr, 0xff00, 0xff00)
	expect(t, "receiver status, its upper byte written", line.Read(at+rcsr), 0)
}

func TestTransmit(t *testing.T) {
	line.Reset()
	expect(t, "transmitter status after a reset", line.Read(at+xcsr), done)
	if line.Pending() {
		println("a byte is pending after a reset")
		t.Fail()
	}

	line.Write(at+xbuf, 'Z', 0xffff)
	expect(t, "transmitter status, a byte on its way", line.Read(at+xcsr), 0)
	if !line.Pending() {
		println("no byte is pending after one was written")
		t.Fail()
	}
	expect(t, "the byte on its way", uint16(line.Next()), 'Z')
	expect(t, "transmitter status, the byte not yet gone", line.Read(at+xcsr), 0)
	line.Sent()
	expect(t, "transmitter status, the byte gone", line.Read(at+xcsr), done)
	expect(t, "the request, interrupts not being enabled", line.Request(), 0)

	// Enabling them while the transmitter is ready requests one at once, and
	// so does every byte that has left.
	line.Write(at+xcsr, enable, 0x00ff)
	expect(t, "the request", line.Request(), 0o064)
	line.Granted(0o064)
	expect(t, "the request, granted", line.Request(), 0)
	line.Write(at+xbuf, 'Y', 0x00ff)
	expect(t, "the request, a byte on its way", line.Request(), 0)
	expect(t, "the second byte", uint16(line.Next()), 'Y')
	line.Sent()
	expect(t, "the request, the byte gone", line.Request(), 0o064)

	// The receiver goes first.
	line.Write(at+rcsr, enable, 0x00ff)
	line.Put('A')
	expect(t, "the request of the two", line.Request(), 0o060)
	line.Granted(0o060)
	expect(t, "the request that is left", line.Request(), 0o064)
}

// A reset does not call back a byte that has been handed to the transmitting
// cog, so the transmitter is not ready until that byte has left.
func TestResetWhileSending(t *testing.T) {
	line.Reset()
	line.Write(at+xbuf, 'A', 0xffff)
	line.Reset()
	expect(t, "transmitter status, reset with a byte on its way", line.Read(at+xcsr), 0)
	if !line.Pending() {
		println("the byte on its way is gone")
		t.Fail()
	}
	expect(t, "the byte on its way", uint16(line.Next()), 'A')
	line.Sent()
	expect(t, "transmitter status, the byte gone", line.Read(at+xcsr), done)

	line.Write(at+xbuf, 'B', 0xffff)
	expect(t, "the byte written after the reset", uint16(line.Next()), 'B')
	line.Sent()
	if line.Pending() {
		println("one byte was written after the reset and two are sent")
		t.Fail()
	}
	expect(t, "transmitter status at the end", line.Read(at+xcsr), done)
}

// A program that writes while the transmitter is busy overwrites what waits
// there, as it does in a UART. It does not make two bytes of one.
func TestWriteWhileBusy(t *testing.T) {
	line.Reset()
	line.Write(at+xbuf, 'A', 0xffff)
	line.Write(at+xbuf, 'B', 0xffff)
	expect(t, "the byte that waits", uint16(line.Next()), 'B')
	line.Sent()
	if line.Pending() {
		println("a second byte is sent")
		t.Fail()
	}
	expect(t, "transmitter status", line.Read(at+xcsr), done)
}

func TestOverrun(t *testing.T) {
	line.Reset()
	line.Lost = 0
	for i := 0; i < ringSize+10; i++ {
		line.Put(byte(i))
	}
	if line.Lost != 10 {
		println("bytes lost:", line.Lost, "want 10")
		t.Fail()
	}
	for i := 0; i < ringSize; i++ {
		if got := line.Read(at + rbuf); got != uint16(i)&0xff {
			println("byte", i, "is", got)
			t.Fail()
			break
		}
	}
	expect(t, "receiver status, the ring read out", line.Read(at+rcsr), 0)
}

// The program of mac/demo.mac says what it is and how much memory there is,
// and then echoes what is typed until a control-D. What it says here is what
// it says in SimH.
const (
	typed = "Hello, 11/40\r\x04"
	said  = "\r\nPDP-11/40 on a Propeller 2, in OctoGo\r\n" +
	"28K words of memory\r\n" +
	"Type; control-D halts.\r\n" +
	"Hello, 11/40\r\n" +
	"\r\nHalted.\r\n"
)

func TestDemo(t *testing.T) {
	if !machine.Attach(&line, at, Size, 4) {
		println("no room on the bus")
		t.Fail()
		return
	}
	machine.Reset()
	machine.Load(mac.DemoAt, mac.Demo[:])
	machine.R[7] = mac.DemoStart

	n := 0
	next := 0
	state := pdp11.Running
	for steps := 0; steps < 1000000 && state != pdp11.Halted; steps += 50 {
		state = machine.Run(50)
		for line.Pending() && n < len(output) {
			output[n] = line.Next()
			n++
			line.Sent()
		}
		if state == pdp11.Waiting && next < len(typed) {
			line.Put(typed[next])
			next++
		}
	}
	if state != pdp11.Halted {
		println("the program did not halt, PC", machine.R[7])
		t.Fail()
	}
	expect(t, "PC", machine.R[7], 0o1214)

	if n != len(said) {
		println("it said", n, "bytes, want", len(said))
		t.Fail()
		return
	}
	for i := 0; i < n; i++ {
		if output[i] != said[i] {
			println("byte", i, "of what it said is", output[i], "want", said[i])
			t.Fail()
			return
		}
	}
}
