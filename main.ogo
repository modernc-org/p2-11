// Command p2-11 is a PDP-11/40 on a Propeller 2. Its console is the serial
// line the program was loaded through, so the terminal of "ogo run" is the
// terminal of the PDP-11.
//
// The machine takes five cogs. One steps the processor. One does nothing but
// read the serial line, because a byte that arrives while a cog is elsewhere
// is lost. One writes the serial line, a byte taking as long to leave as forty
// or so instructions take to execute. One counts the cycles of a power line
// there is none of, for the line clock. One moves blocks between the SD card
// and memory, for the disk.
//
// With a card in the slot that has a file RK0.DSK, the machine begins with
// what is on that pack. Without one it runs a program of its own.

import (
	"p2"

	"modernc.org/p2-11/dl11"
	"modernc.org/p2-11/kw11"
	"modernc.org/p2-11/mac"
	"modernc.org/p2-11/pdp11"
	"modernc.org/p2-11/rk11"
)

const (
	// hz is how many cycles a second the power line has: sixty where the
	// PDP-11 comes from, and what its software expects unless it is told
	// otherwise.
	hz = 60

	// apart is how many instructions there are between two characters the
	// console hands the machine, however fast they are typed. It is what
	// SimH leaves between them.
	apart = 1000
)

var (
	machine pdp11.Machine
	console dl11.Line
	clock   kw11.Clock

	// memory is all that 18 bits of address reach: 248 KB. It is part of
	// the binary, so the binary is that much larger to load.
	memory [pdp11.MaxWords]uint16
)

func init() {
	machine.Memory(memory[:])
}

// receive hands the console what arrives on the serial line.
func receive() {
	for {
		console.Put(byte(p2.ReadByte(0)))
	}
}

// transmit puts what the console sends on the serial line, seven bits of it,
// as SimH's console does: Unix V6 sends a character with its even parity in
// the eighth bit, which a terminal of today takes for another character, and
// then a carriage return is not one.
func transmit() {
	for {
		p2.WriteByte(console.Next() & 0x7f)
		console.Sent()
	}
}

// line tells the clock of every cycle of the power line. A cycle is timed from
// when its second began and not from the cycle before it, so that what one is
// late by is not added to the next, and hz of them are a second to the
// microsecond. A cycle that is over before it is waited for is not waited for.
func line() {
	second := p2.GetUs()
	for {
		for i := uint32(1); i <= hz; i++ {
			p2.WaitUs(int(second + i*1000000/hz - p2.GetUs()))
			clock.Tick()
		}
		second += 1000000
	}
}

// attach puts the devices on the machine's bus. It reports whether there was
// room for them.
func attach() bool {
	console.Pace(&machine, apart)
	disk.Connect(&machine, 0)
	return machine.Attach(&clock, 0o177546, kw11.Size, 6) &&
		machine.Attach(&disk, 0o177400, rk11.Size, 5) &&
		machine.Attach(&console, 0o177560, dl11.Size, 4)
}

// run loads a program, starts it, and runs the machine until it halts. It
// reports whether it did.
func run(at, start uint16, program []uint16) bool {
	machine.Reset()
	if !machine.Load(at, program) {
		println("the program does not fit the memory")
		return false
	}
	machine.R[7] = start
	for {
		switch machine.Run(1 << 20) {
		case pdp11.Halted:
			return true
		case pdp11.Faulted:
			printf("\r\nno vector or no stack for a trap, PC %06o SP %06o PSW %06o\r\n",
				machine.R[7], machine.R[6], machine.PSW())
			return false
		}
	}
}

func main() {
	if !attach() {
		println("no room on the bus")
		return
	}
	go receive()
	go transmit()
	go line()
	pack := drives()

	t := p2.GetMs()
	run(mac.BenchAt, mac.BenchStart, mac.Bench[:])
	t = p2.GetMs() - t
	n := machine.Count
	printf("\r\n%d instructions in %d ms, %d a second\r\n", n, t, uint64(n)*1000/uint64(t))

	t = p2.GetMs()
	run(mac.TicksAt, mac.TicksStart, mac.Ticks[:])
	t = p2.GetMs() - t
	printf("%d cycles of the line clock in %d ms\r\n", machine.R[3], t)

	if pack {
		run(mac.BootAt, mac.BootStart, mac.Boot[:])
	} else {
		run(mac.DemoAt, mac.DemoStart, mac.Demo[:])
	}
	printf("PC %06o\r\n", machine.R[7])
}
