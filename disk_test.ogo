import (
	"testing"

	"modernc.org/p2-11/core"
	"modernc.org/p2-11/mac"
	"modernc.org/p2-11/pdp11"
	"modernc.org/p2-11/rk11"
	"modernc.org/p2-11/sd"
)

// The disk with everything there is to it: the machine on this cog, the
// controller between this and the cog of the disk, and the card. The program
// is mac/disk.mac, the pack in drive 0 is TEST.DSK, and what the program
// leaves is what it leaves in SimH. The blocks it writes are given back what
// they had, through the controller, the card being the other cog's from
// here on.

const (
	rkcs = 0o177404
	rkwc = 0o177406
	rkba = 0o177410
	rkda = 0o177412

	readBlock  = 0o005
	writeBlock = 0o003
	checkBlock = 0o007
	diskDone   = 0o200
	diskFailed = 0o100000

	somewhere = 0o20000 // in memory
)

// A second is the pack in drive 1, which is made up: a block of it is its
// own number 128 times, and the number of the drive in every other word.
type second struct{}

var (
	other   second
	noWrite = trouble{"a pack that is made up is not written to"}
)

func (s *second) Read(block uint32, b []byte) error {
	for i := 0; i < len(b); i += 4 {
		b[i] = byte(block)
		b[i+1] = byte(block >> 8)
		b[i+2] = 1
		b[i+3] = 0
	}
	return nil
}

func (s *second) Write(block uint32, b []byte) error {
	return &noWrite
}

// do has the controller do a function with a block of the pack in drive 0
// and the memory at somewhere, waits for it, and answers what the controller
// then says.
func do(function uint16, block uint32) uint16 {
	machine.Deposit(rkda, uint16(block/12)<<4|uint16(block%12))
	machine.Deposit(rkba, somewhere)
	machine.Deposit(rkwc, 0o177400)
	machine.Deposit(rkcs, function)
	for {
		if v, _ := machine.Examine(rkcs); v&diskDone != 0 {
			return v
		}
	}
}

// started says whether the cog of the disk has been started, and packed
// whether drive 0 has a pack then, which is TEST.DSK in these tests.
var started, packed bool

// testDisk starts the cog of the disk, once, and reports whether TEST.DSK is
// the pack in drive 0. It fails the test unless that is so or there is no
// card.
func testDisk(t *testing.T) bool {
	if !started {
		started = true
		names[0] = "TEST.DSK"
		packed = drives()
	}
	if !packed && noCard != &sd.ErrNoCard && noCard != nil {
		t.Fail()
	}
	return packed
}

func TestDiskProgram(t *testing.T) {
	switch {
	case !bus():
		println("no room on the bus")
		t.Fail()
		return
	case !testDisk(t):
		println("nothing tested")
		return
	}
	disk.Attach(1, &other, false)

	for a := uint32(0); a < pdp11.IOPage; a += 2 {
		machine.Deposit(uint16(a), 0)
	}
	if !run(mac.DiskAt, mac.DiskStart, mac.Disk[:]) {
		println("the program did not halt")
		t.Fail()
	}
	if machine.R[7] != mac.DiskHalts || machine.R[5] != mac.DiskTableAt+2*uint16(len(mac.DiskTable)) {
		printf("PC %06o, and the table ends at %06o\n", machine.R[7], machine.R[5])
		t.Fail()
	}
	wrong := 0
	for i, want := range mac.DiskTable {
		a := mac.DiskTableAt + 2*uint16(i)
		if got, _ := machine.Examine(a); got != want && wrong < 10 {
			printf("%06o: %06o, want %06o\n", a, got, want)
			wrong++
			t.Fail()
		}
	}

	// What the program has written to, as it was.
	machine.Reset()
	for block := uint32(200); block <= 203; block++ {
		for i := uint16(0); i < rk11.BlockSize; i += 4 {
			machine.Deposit(somewhere+i, uint16(block))
			machine.Deposit(somewhere+i+2, 0)
		}
		if do(writeBlock, block)&diskFailed != 0 || do(checkBlock, block)&diskFailed != 0 {
			println("block", block, "of TEST.DSK is not what it was")
			t.Fail()
		}
	}
}

// An instruction that reads a word and writes it back holds the bus between
// the two, as DATIP and DATO, and no device moves data to that word in
// between: what the disk reads into memory either comes before the read, and
// the instruction changes it, or after the write, and stays. Here the machine
// increments the first word of a block the disk is reading into memory, over
// and over, with the core and without, and the word ends up holding the
// block's number with as many added as came after, unless what the disk wrote
// there was lost, and the word is what it was with all of them added.
var increments = [...]uint16{
	0o005210, // INC (R0)
	0o000776, // BR .-2
}

const (
	incrementsAt = 0o1000
	before       = 0o100000 // what the word holds before a block is read, more than any number added
	blockReads   = 100
)

func TestDiskReadModifyWrite(t *testing.T) {
	switch {
	case !bus():
		println("no room on the bus")
		t.Fail()
		return
	case !testDisk(t):
		println("nothing tested")
		return
	}
	for pass := 0; pass < 2; pass++ {
		if pass == 1 {
			core.Detach(&machine)
		}
		machine.Reset()
		machine.Load(incrementsAt, increments[:])
		lost := 0
		for block := uint32(100); block < 100+blockReads; block++ {
			machine.Deposit(somewhere, before)
			machine.R[0] = somewhere
			machine.R[7] = incrementsAt
			machine.Deposit(rkda, uint16(block/12)<<4|uint16(block%12))
			machine.Deposit(rkba, somewhere)
			machine.Deposit(rkwc, 0o177400)
			machine.Deposit(rkcs, readBlock)
			machine.Run(4096)
			for {
				if v, _ := machine.Examine(rkcs); v&diskDone != 0 {
					if v&diskFailed != 0 {
						println("block", block, "of TEST.DSK cannot be read")
						t.Fail()
					}
					break
				}
			}
			if v, _ := machine.Examine(somewhere); v >= before {
				lost++
			}
		}
		if lost != 0 {
			printf("pass %d: %d of %d words the disk wrote were lost\n", pass, lost, blockReads)
			t.Fail()
		}
	}
	accelerate()
}
