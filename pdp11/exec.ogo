// The instructions.
//
// Each does things in the order the 11/40 does them, so that an instruction
// ended by a failed access leaves behind what it leaves on the real machine.
//
// What is written here is written for a processor on which a call costs as
// much as fifty instructions and a function with a branch in it is not
// inlined. So Run fetches an instruction where it stands and finds the
// function that does it, and that function is all there is to most of them:
// an operand in a register is dealt with where it is met, and only an operand
// in memory is worth the calls that find and fetch it.

// Step takes the traps and the interrupt that are due and then executes one
// instruction. A trap an instruction ends in is taken by the step after it.
// An instruction that cannot be fetched is none: the step takes the trap that
// is and goes on to the instruction the trap leads to.
func (m *Machine) Step() State {
	return m.Run(1)
}

// Run executes n instructions, or fewer if the machine does not go on running
// for as long, and answers what the machine is doing then.
func (m *Machine) Run(n uint32) State {
	state := Running
	all := n
	from := m.now
	mem := m.mem // in registers, for the fetch
	for n != 0 {
		// Whatever else there is to do than the next instruction.
		m.now = from + all - n
		if !m.due() {
			state = Faulted
			break
		}
		if m.waiting {
			from += pollEvery // time passes for a machine that waits
			state = Waiting
			break
		}
		if m.psw&flagT != 0 {
			m.traps |= trapTrace
		}

		// What fetching an instruction looks at, kept in registers for as
		// long as nothing can have changed it: the status register of the
		// memory management, and the page the program is in when the unit
		// is on. A write to a register of the unit, a change of mode and
		// an abort all end the run of instructions below, so what is here
		// is looked at again before it is out of date.
		sr0 := m.sr0
		codePage, codeLow, codeHigh, codeBase := uint16(8), uint16(0), uint16(0), uint32(0)

		// And then instructions, until one of them asks for that again or
		// the devices have not been asked for long enough.
		left := uint32(pollEvery)
		if m.core != nil {
			left = coreEvery
		}
		if left > n {
			left = n
		}
		for {
			// The core, if there is one, executes as many of the
			// instructions as it will. One it leaves is the machine's.
			// It is not given any while a trap is due, which the trace
			// bit has requested if it is set.
			if m.core != nil && m.traps == 0 {
				done := m.core.Execute(left)
				n -= done
				left -= done
				if left == 0 {
					break
				}
			}

			// The unit notes where the instruction is, unless an abort
			// holds its registers. The instruction is fetched where it
			// stands if it is in memory the processor reaches as it is, or
			// in a page it may read from, whose place is looked up when
			// the program comes to the page.
			var ir uint16
			pc := m.R[7]
			if sr0&sr0Errors == 0 {
				m.sr2 = pc
			}
			i := uint32(pc >> 1)
			ok := pc < IOPage
			if sr0&sr0Enable != 0 {
				if pc>>13 != codePage {
					codePage = 8
					if p := &m.pages[m.space][pc>>13]; p.may&dati != 0 && p.base < ioBase {
						codePage, codeLow, codeHigh, codeBase = pc>>13, p.low, p.high, p.base
					}
				}
				d := pc & pageOffset
				i = (codeBase + uint32(d)) >> 1
				ok = pc>>13 == codePage && d >= codeLow && d <= codeHigh
			}
			if ok && pc&1 == 0 && i < uint32(len(mem)) {
				ir = mem[i]
			} else {
				ir = m.read(pc, 2, dati)
				if m.traps&aborts != 0 {
					break // no instruction, so none is counted
				}
			}
			m.R[7] = pc + 2

			// The instruction, found by its upper bits, what comes most
			// often first: the two-operand instructions are half of what
			// a program does, the branches a sixth and SOB a tenth.
			c := ir >> 12
			switch {
			case c&7 != 0 && c&7 != 7:
				if c >= 0o11 && c <= 0o15 {
					m.double(ir, 1) // the byte instructions; SUB is 16
				} else {
					m.double(ir, 2)
				}
			case ir&0o077777 < 0o004000 && ir&0o177400 != 0: // 000400 to 003777 and 100000 to 103777
				m.branch(ir)
			case c == 0o07: // 070000 to 077777
				switch ir >> 9 & 7 {
				case 7: // SOB
					r := ir >> 6 & 7
					v := m.R[r] - 1
					m.R[r] = v
					if v != 0 {
						m.R[7] -= ir & 0o77 << 1
					}
				case 0:
					m.mul(ir)
				case 1:
					m.div(ir)
				case 2:
					m.ash(ir)
				case 3:
					m.ashc(ir)
				case 4:
					m.xor(ir)
				default: // the floating instruction set and the commercial one
					m.traps |= trapReserved
				}
			case c == 0o00: // 000000 to 007777, the branches taken out
				op := ir >> 6 & 0o77
				switch {
				case op >= 0o50 && op < 0o64:
					m.single(ir, 2)
				case op == 0o66:
					m.mtpi(ir)
				case op >= 0o40 && op < 0o50:
					m.jsr(ir)
				case op == 0o02:
					m.group0002(ir)
				case op == 0o65:
					m.mfpi(ir)
				case op == 0o01:
					m.jmp(ir)
				case op == 0o00:
					m.control(ir)
				case op == 0o03:
					m.swab(ir)
				case op == 0o64:
					m.mark(ir)
				case op == 0o67:
					m.sxt(ir)
				default:
					m.traps |= trapReserved
				}
			case c == 0o10: // 100000 to 107777, the branches taken out
				op := ir >> 6 & 0o77
				switch {
				case op >= 0o50 && op < 0o64:
					m.single(ir, 1)
				case op < 0o44:
					m.traps |= trapEMT
				case op < 0o50:
					m.traps |= trapTRAP
				case op == 0o65: // MFPD, which without separate data space is MFPI
					m.mfpi(ir)
				case op == 0o66: // MTPD
					m.mtpi(ir)
				default:
					m.traps |= trapReserved
				}
			default: // the floating point processor's
				m.traps |= trapReserved
			}
			n--
			left--
			if left == 0 || m.traps != 0 {
				break
			}
		}
		if m.halted {
			m.halted = false
			state = Halted
			break
		}
	}
	if state == Running && m.waiting {
		state = Waiting // the last of the n was a WAIT
	}
	m.Count += all - n
	m.now = from + all - n
	return state
}

// control is the instructions that have no operand.
func (m *Machine) control(ir uint16) {
	switch ir {
	case 0o000000: // HALT
		if m.psw&currentMode != kernel {
			m.traps |= trapReserved
			return
		}
		m.halted = true
		m.traps |= attention
	case 0o000001: // WAIT
		m.waiting = true
		m.traps |= attention
	case 0o000002, 0o000006: // RTI, RTT
		pc := m.read(m.R[6], 2, dati)
		if m.traps&aborts != 0 {
			return
		}
		psw := m.read(m.R[6]+2, 2, dati)
		if m.traps&aborts != 0 {
			return
		}
		m.R[6] += 4
		if m.psw&currentMode != kernel {
			// Only the kernel lowers a mode or changes the priority.
			psw = psw&^priorityBits | m.psw&(currentMode|previousMode|priorityBits)
		}
		m.setPSW(psw)
		m.R[7] = pc
		if ir == 0o000002 && psw&flagT != 0 {
			m.traps |= trapTrace // RTT lets one instruction run first
		}
	case 0o000003:
		m.traps |= trapBPT
	case 0o000004:
		m.traps |= trapIOT
	case 0o000005: // RESET, which turns the memory management off as well
		if m.psw&currentMode == kernel {
			m.resetDevices()
			m.sr0 = 0
			m.traps |= attention
		}
	default:
		m.traps |= trapReserved
	}
}

// group0002 is the instructions from 000200 to 000277: RTS and the ones that
// set and clear condition codes.
func (m *Machine) group0002(ir uint16) {
	switch {
	case ir < 0o000210: // RTS
		r := ir & 7
		m.R[7] = m.R[r]
		v := m.read(m.R[6], 2, dati)
		if m.traps&aborts != 0 {
			return
		}
		m.R[r] = v
		if r != 6 {
			m.R[6] += 2
		}
	case ir < 0o000240: // SPL among them, which the 11/45 has
		m.traps |= trapReserved
	case ir < 0o000260: // CLC, CLV, CLZ, CLN and their combinations
		m.psw &^= ir & flags
	default: // SEC, SEV, SEZ, SEN and theirs
		m.psw |= ir & flags
	}
}

// branch takes the branch ir is if its condition holds.
func (m *Machine) branch(ir uint16) {
	psw := m.psw
	n := psw&flagN != 0
	z := psw&flagZ != 0
	v := psw&flagV != 0
	c := psw&flagC != 0
	var take bool
	switch ir >> 8 {
	case 0o001: // BR
		take = true
	case 0o002: // BNE
		take = !z
	case 0o003: // BEQ
		take = z
	case 0o004: // BGE
		take = n == v
	case 0o005: // BLT
		take = n != v
	case 0o006: // BGT
		take = !z && n == v
	case 0o007: // BLE
		take = z || n != v
	case 0o200: // BPL
		take = !n
	case 0o201: // BMI
		take = n
	case 0o202: // BHI
		take = !c && !z
	case 0o203: // BLOS
		take = c || z
	case 0o204: // BVC
		take = !v
	case 0o205: // BVS
		take = v
	case 0o206: // BCC
		take = !c
	case 0o207: // BCS
		take = c
	}
	if take {
		m.R[7] += uint16(int16(int8(ir))) << 1
	}
}

func (m *Machine) jmp(ir uint16) {
	if ir&0o70 == 0 {
		m.traps |= trapJump
		return
	}
	a := m.address(ir&0o77, 2)
	if m.traps&aborts != 0 {
		return
	}
	m.R[7] = a
}

func (m *Machine) jsr(ir uint16) {
	if ir&0o70 == 0 {
		m.traps |= trapJump
		return
	}
	a := m.address(ir&0o77, 2)
	if m.traps&aborts != 0 {
		return
	}
	r := ir >> 6 & 7
	sp := m.R[6] - 2
	m.R[6] = sp
	m.write(sp, 2, m.R[r])
	if m.traps&aborts != 0 {
		return
	}
	if sp < stackLimit {
		m.stackCheck(sp)
	}
	m.R[r] = m.R[7]
	m.R[7] = a
}

func (m *Machine) mark(ir uint16) {
	a := m.R[7] + ir&0o77<<1
	m.R[7] = m.R[5]
	v := m.read(a, 2, dati)
	if m.traps&aborts != 0 {
		return
	}
	m.R[5] = v
	m.R[6] = a + 2
}

func (m *Machine) swab(ir uint16) {
	var a, v uint16
	d := ir & 0o77
	if d < 8 {
		v = m.R[d]
	} else {
		a = m.address(d, 2)
		if m.traps&aborts != 0 {
			return
		}
		v = m.read(a, 2, datip)
		if m.traps&aborts != 0 {
			return
		}
	}
	v = v<<8 | v>>8
	cc := uint16(0)
	switch {
	case v&0xff == 0:
		cc = flagZ
	case v&0x80 != 0:
		cc = flagN
	}
	m.psw = m.psw&^flags | cc
	if d < 8 {
		m.R[d] = v
		return
	}
	m.write(a, 2, v)
}

func (m *Machine) sxt(ir uint16) {
	var v uint16
	if m.psw&flagN != 0 {
		v = 0xffff
		m.psw &^= flagZ | flagV
	} else {
		m.psw = m.psw&^flagV | flagZ
	}
	d := ir & 0o77
	if d < 8 {
		m.R[d] = v
		return
	}
	a := m.address(d, 2)
	if m.traps&aborts != 0 {
		return
	}
	m.write(a, 2, v)
}

func (m *Machine) xor(ir uint16) {
	var a, v uint16
	d := ir & 0o77
	if d < 8 {
		v = m.R[d]
	} else {
		a = m.address(d, 2)
		if m.traps&aborts != 0 {
			return
		}
		v = m.read(a, 2, datip)
		if m.traps&aborts != 0 {
			return
		}
	}
	v ^= m.R[ir>>6&7]
	cc := uint16(0)
	switch {
	case v == 0:
		cc = flagZ
	case v&0x8000 != 0:
		cc = flagN
	}
	m.psw = m.psw&^(flagN|flagZ|flagV) | cc
	if d < 8 {
		m.R[d] = v
		return
	}
	m.write(a, 2, v)
}

// mfpi pushes a word of the previous mode's: its stack pointer, when that is
// what the operand names and the modes differ, or the word at the operand's
// address in the previous mode's space, the address itself having been
// found in the current one's.
func (m *Machine) mfpi(ir uint16) {
	var v uint16
	s := ir & 0o77
	now, before := m.psw>>14, m.psw>>12&3
	switch {
	case s == 6 && now != before:
		v = m.sp[before]
	case s < 8:
		v = m.R[s]
	default:
		a := m.address(s, 2)
		if m.traps&aborts != 0 {
			return
		}
		m.space = before
		v = m.read(a, 2, dati)
		m.space = now
		if m.traps&aborts != 0 {
			return
		}
	}
	cc := uint16(0)
	switch {
	case v == 0:
		cc = flagZ
	case v&0x8000 != 0:
		cc = flagN
	}
	m.psw = m.psw&^(flagN|flagZ|flagV) | cc
	m.R[6] -= 2
	m.write(m.R[6], 2, v)
	if m.traps&aborts != 0 {
		return
	}
	m.stackCheck(m.R[6])
}

// mtpi pops a word into the previous mode's.
func (m *Machine) mtpi(ir uint16) {
	v := m.read(m.R[6], 2, dati)
	if m.traps&aborts != 0 {
		return
	}
	cc := uint16(0)
	switch {
	case v == 0:
		cc = flagZ
	case v&0x8000 != 0:
		cc = flagN
	}
	m.psw = m.psw&^(flagN|flagZ|flagV) | cc
	m.R[6] += 2
	d := ir & 0o77
	now, before := m.psw>>14, m.psw>>12&3
	switch {
	case d == 6 && now != before:
		m.sp[before] = v
	case d < 8:
		m.R[d] = v
	default:
		a := m.address(d, 2)
		if m.traps&aborts != 0 {
			return
		}
		m.space = before
		m.write(a, 2, v)
		m.space = now
	}
}

// single is the instructions that have one operand and do arithmetic on it,
// 005000 to 006377 on a word and 105000 to 106377 on a byte.
func (m *Machine) single(ir, size uint16) {
	sign, mask := uint16(0x8000), uint16(0xffff)
	if size == 1 {
		sign, mask = 0x80, 0xff
	}
	op := ir >> 6 & 0o77
	d := ir & 0o77

	// The operand, which CLR does not read and sets the condition codes
	// before it has found.
	var a, v uint16
	if op == 0o50 {
		m.psw = m.psw&^flags | flagZ
	}
	if d < 8 {
		v = m.R[d] & mask
	} else {
		a = m.address(d, size)
		if m.traps&aborts != 0 {
			return
		}
		if op != 0o50 {
			cycle := uint16(datip)
			if op == 0o57 {
				cycle = dati // TST does not write it back
			}
			v = m.read(a, size, cycle)
			if m.traps&aborts != 0 {
				return
			}
		}
	}

	// What becomes of it, and the condition codes: the carry as the case
	// sets it, the overflow with it for a shift, and N and Z from the result.
	psw := m.psw
	c := psw & flagC
	var r, cc uint16
	switch op {
	case 0o50: // CLR
		cc = flagZ
	case 0o51: // COM
		r = ^v & mask
		cc = flagC
	case 0o52: // INC
		r = (v + 1) & mask
		cc = c
		if r == sign {
			cc |= flagV
		}
	case 0o53: // DEC
		r = (v - 1) & mask
		cc = c
		if r == sign-1 {
			cc |= flagV
		}
	case 0o54: // NEG
		r = -v & mask
		if r == sign {
			cc = flagV
		}
		if r != 0 {
			cc |= flagC
		}
	case 0o55: // ADC
		r = (v + c) & mask
		if c != 0 && r == sign {
			cc = flagV
		}
		if c != 0 && r == 0 {
			cc |= flagC
		}
	case 0o56: // SBC
		r = (v - c) & mask
		if c != 0 && r == sign-1 {
			cc = flagV
		}
		if c != 0 && r == mask {
			cc |= flagC
		}
	case 0o57: // TST
		r = v
	case 0o60: // ROR
		r = v >> 1
		if c != 0 {
			r |= sign
		}
		cc = v & flagC
	case 0o61: // ROL
		r = (v<<1 | c) & mask
		if v&sign != 0 {
			cc = flagC
		}
	case 0o62: // ASR
		r = v>>1 | v&sign
		cc = v & flagC
	case 0o63: // ASL
		r = v << 1 & mask
		if v&sign != 0 {
			cc = flagC
		}
	}
	switch {
	case r == 0:
		cc |= flagZ
	case r&sign != 0:
		cc |= flagN
	}
	if op >= 0o60 && (cc&flagN != 0) != (cc&flagC != 0) {
		cc |= flagV // a shift overflows if the sign is not what came out
	}
	m.psw = psw&^flags | cc

	switch {
	case op == 0o57:
	case d >= 8:
		m.write(a, size, r)
	case size == 1:
		m.R[d] = m.R[d]&0xff00 | r
	default:
		m.R[d] = r
	}
}

// double is the instructions that have two operands, except those of the
// extended instruction set.
func (m *Machine) double(ir, size uint16) {
	sign, mask := uint16(0x8000), uint16(0xffff)
	if size == 1 {
		sign, mask = 0x80, 0xff
	}
	op := ir >> 12 & 7
	s := ir >> 6 & 0o77
	d := ir & 0o77

	// The operands. A source in memory is fetched before the destination is
	// decoded. A source in a register is read after, so that MOV R0,(R0)+
	// stores what the register holds once it has stepped. A source that is
	// the word after the instruction, #n, which a third of sources are, is
	// found where it stands rather than through address: the PC is stepped
	// before the read, as address steps it and as the real machine does.
	var src, a, v uint16
	if s >= 8 {
		if s == 0o27 {
			a = m.R[7]
			m.R[7] = a + 2
		} else {
			a = m.address(s, size)
			if m.traps&aborts != 0 {
				return
			}
		}
		src = m.read(a, size, dati)
		if m.traps&aborts != 0 {
			return
		}
	}
	if d >= 8 {
		a = m.address(d, size)
		if m.traps&aborts != 0 {
			return
		}
	}
	if s < 8 {
		src = m.R[s] & mask
	}
	if op != 1 { // MOV does not read where it writes
		if d < 8 {
			v = m.R[d] & mask
		} else {
			cycle := uint16(datip)
			if op == 2 || op == 3 {
				cycle = dati // CMP and BIT do not write it back
			}
			v = m.read(a, size, cycle)
			if m.traps&aborts != 0 {
				return
			}
		}
	}

	// What becomes of them, and the condition codes, of which MOV and the
	// three that deal in bits leave the carry alone.
	psw := m.psw
	cc := psw & flagC
	var r uint16
	switch op {
	case 1: // MOV, MOVB
		r = src
	case 2: // CMP, CMPB
		r = (src - v) & mask
		cc = 0
		if (src^v)&(^v^r)&sign != 0 {
			cc = flagV
		}
		if src < v {
			cc |= flagC
		}
	case 3: // BIT, BITB
		r = src & v
	case 4: // BIC, BICB
		r = v &^ src
	case 5: // BIS, BISB
		r = v | src
	case 6: // ADD, and SUB under 16
		cc = 0
		if ir&0x8000 == 0 {
			r = v + src
			if (^src^v)&(src^r)&sign != 0 {
				cc = flagV
			}
			if r < src {
				cc |= flagC
			}
		} else {
			r = v - src
			if (src^v)&(^src^r)&sign != 0 {
				cc = flagV
			}
			if v < src {
				cc |= flagC
			}
		}
	}
	switch {
	case r == 0:
		cc |= flagZ
	case r&sign != 0:
		cc |= flagN
	}
	m.psw = psw&^flags | cc

	switch {
	case op == 2 || op == 3:
	case d >= 8:
		m.write(a, size, r)
	case size == 2:
		m.R[d] = r
	case op == 1:
		m.R[d] = uint16(int16(int8(r))) // a byte moved to a register fills it
	default:
		m.R[d] = m.R[d]&0xff00 | r
	}
}
