import "testing"

// The machine with devices on its bus, and what the console does to it. What
// the instructions do is the business of the vectors.

// A bell is a device of one register that requests an interrupt when it is
// rung.
type bell struct {
	vector  uint16
	reg     uint16
	ringing bool
	granted int
	resets  int

	seen uint32 // how far the machine had come when it was last here
	back int    // how often it had come less far than the time before
}

// look sees how far the machine has come.
func (b *bell) look() {
	if now := tm.Now(); now < b.seen {
		b.back++
	} else {
		b.seen = now
	}
}

func (b *bell) Reset() {
	b.ringing = false
	b.resets++
}

func (b *bell) Read(a uint16) uint16 {
	return b.reg
}

func (b *bell) Write(a, v, mask uint16) {
	b.look()
	b.reg = b.reg&^mask | v&mask
}

func (b *bell) Request() uint16 {
	b.look()
	if b.ringing {
		return b.vector
	}
	return 0
}

func (b *bell) Granted(vector uint16) {
	b.ringing = false
	b.granted++
}

var (
	tm       Machine
	tmMemory [28 * 1024]uint16
	low      bell // at 164000, priority 4, vector 300
	high     bell // at 164002, priority 6, vector 310

	bells   [maxDevices]bell
	crowded Machine // which has no memory, and needs none
)

func init() {
	tm.Memory(tmMemory[:])
}

const (
	lowAt  = 0o164000
	highAt = 0o164002
)

// fresh brings tm to the state every test here starts from: the two bells on
// the bus, their vectors leading to 2000 and 3000 at priority 7, the stack at
// 1000, and program at 1000 with the program counter on it.
func fresh(program []uint16) {
	if tm.ndevices == 0 {
		tm.Attach(&low, lowAt, 2, 4)
		tm.Attach(&high, highAt, 2, 6)
	}
	low = bell{vector: 0o300}
	high = bell{vector: 0o310}
	tm.Reset()
	for a := uint16(0); a < 0o4000; a += 2 {
		tm.Deposit(a, 0)
	}
	tm.Deposit(0o300, 0o2000)
	tm.Deposit(0o302, 0o340)
	tm.Deposit(0o310, 0o3000)
	tm.Deposit(0o312, 0o340)
	tm.Load(0o1000, program)
	tm.R[6] = 0o1000
	tm.R[7] = 0o1000
}

// expect fails the test unless got is want.
func expect(t *testing.T, what string, got, want uint16) {
	if got != want {
		printf("%s %06o, want %06o\n", what, got, want)
		t.Fail()
	}
}

func TestAttach(t *testing.T) {
	var ok bool
	ok = crowded.Attach(&bells[0], 0o160000, 2, 4)
	ok = ok && !crowded.Attach(&bells[1], 0o157776, 2, 4) // below the I/O page
	ok = ok && !crowded.Attach(&bells[1], 0o160011, 2, 4) // odd
	ok = ok && !crowded.Attach(&bells[1], 0o160010, 3, 4) // an odd size
	ok = ok && !crowded.Attach(&bells[1], 0o160010, 0, 4) // no size
	ok = ok && !crowded.Attach(&bells[1], 0o177776, 4, 4) // past the end
	ok = ok && !crowded.Attach(&bells[1], 0o177774, 4, 4) // over the status word
	ok = ok && !crowded.Attach(&bells[1], 0o177570, 2, 4) // over the switch register
	ok = ok && !crowded.Attach(&bells[1], 0o177572, 2, 4) // over SR0
	ok = ok && !crowded.Attach(&bells[1], 0o177576, 2, 4) // over SR2
	ok = ok && !crowded.Attach(&bells[1], 0o172276, 4, 4) // over the kernel's first page descriptor
	ok = ok && !crowded.Attach(&bells[1], 0o177676, 2, 4) // over the user's last page address
	ok = ok && crowded.Attach(&bells[1], 0o177574, 2, 4)  // SR1, which the 11/40 has not
	ok = ok && !crowded.Attach(&bells[1], 0o160000, 2, 4) // over the first
	ok = ok && !crowded.Attach(&bells[1], 0o160010, 2, 3) // no such priority
	ok = ok && !crowded.Attach(&bells[1], 0o160010, 2, 8)
	for i := 2; i < maxDevices; i++ {
		ok = ok && crowded.Attach(&bells[i], 0o160000+uint16(8*i), 4, uint16(4+i&3))
	}
	ok = ok && !crowded.Attach(&bells[0], 0o170000, 2, 4) // the bus is full
	if !ok {
		println("Attach took what it should refuse, or refused what it should take")
		t.Fail()
	}

	// They are asked in the order of their priorities.
	for i := 1; i < crowded.ndevices; i++ {
		if crowded.devices[i-1].priority < crowded.devices[i].priority {
			println("slot", i, "has a higher priority than the one before it")
			t.Fail()
		}
	}
}

func TestConsole(t *testing.T) {
	fresh(nil)
	v, ok := tm.Examine(0o1000)
	if !ok || v != 0 {
		println("Examine of memory:", v, ok)
		t.Fail()
	}
	if !tm.Deposit(0o157776, 0o123456) {
		println("Deposit refused the last word of memory")
		t.Fail()
	}
	v, _ = tm.Examine(0o157776)
	expect(t, "the last word of memory", v, 0o123456)
	tm.Deposit(0o157776, 0)

	_, ok = tm.Examine(0o1001)
	if ok {
		println("Examine took an odd address")
		t.Fail()
	}
	_, ok = tm.Examine(0o160000)
	if ok {
		println("Examine found something at 160000")
		t.Fail()
	}
	if tm.Deposit(0o160000, 1) {
		println("Deposit found something at 160000")
		t.Fail()
	}

	// A device's register, and the two of the processor.
	tm.Deposit(lowAt, 0o4321)
	expect(t, "the bell's register", low.reg, 0o4321)
	v, _ = tm.Examine(lowAt)
	expect(t, "the bell's register, examined", v, 0o4321)
	tm.Switches = 0o173030
	v, _ = tm.Examine(SwitchRegister)
	expect(t, "the switch register", v, 0o173030)
	tm.Deposit(SwitchRegister, 0o52525)
	expect(t, "the display register", tm.Display, 0o52525)
	tm.SetPSW(0o357)
	v, _ = tm.Examine(StatusWord)
	expect(t, "the status word", v, 0o357)

	// None of which has left a trap behind.
	tm.SetPSW(0)
	tm.Load(0o1000, []uint16{0o000240}) // NOP
	tm.Step()
	tm.Step()
	expect(t, "PC", tm.R[7], 0o1004)
}

func TestDeviceRegister(t *testing.T) {
	fresh([]uint16{
		0o012737, 0o123456, lowAt, // MOV #123456, @#low
		0o112737, 0o000377, lowAt, // MOVB #377, @#low
		0o112737, 0o000001, lowAt + 1, // MOVB #1, @#low+1
		0o013700, lowAt, // MOV @#low, R0
		0o113701, lowAt + 1, // MOVB @#low+1, R1
		0o005237, highAt, // INC @#high
		0o000000, // HALT
	})
	tm.Step()
	expect(t, "a word written", low.reg, 0o123456)
	tm.Step()
	expect(t, "the lower byte written", low.reg, 0o123777)
	tm.Step()
	expect(t, "the upper byte written", low.reg, 0o000777)
	tm.Step()
	expect(t, "a word read", tm.R[0], 0o000777)
	tm.Step()
	expect(t, "a byte read", tm.R[1], 0o000001)
	tm.Step()
	expect(t, "a word incremented", high.reg, 1)
	if s := tm.Step(); s != Halted {
		println("the state after HALT:", int(s))
		t.Fail()
	}
	expect(t, "PC", tm.R[7], 0o1040)
	if tm.Count != 7 {
		println("instructions counted:", tm.Count)
		t.Fail()
	}
}

func TestInterrupt(t *testing.T) {
	fresh([]uint16{0o000777})    // BR .
	tm.Deposit(0o2000, 0o000002) // RTI
	tm.SetPSW(0o005)
	tm.Run(100)
	expect(t, "PC, nothing having rung", tm.R[7], 0o1000)

	low.ringing = true
	tm.Run(100)
	expect(t, "PC after the return", tm.R[7], 0o1000)
	expect(t, "the status word after the return", tm.PSW(), 0o005)
	expect(t, "SP after the return", tm.R[6], 0o1000)
	v, _ := tm.Examine(0o776)
	expect(t, "the status word that was pushed", v, 0o005)
	v, _ = tm.Examine(0o774)
	expect(t, "the program counter that was pushed", v, 0o1000)
	if low.granted != 1 || low.ringing {
		println("the bell was granted", low.granted, "times")
		t.Fail()
	}

	// A processor at the priority of the request does not take it, one below
	// it does, and it does as soon as it is.
	fresh([]uint16{
		0o000240,                     // NOP
		0o012737, 0o000140, 0o177776, // MOV #140, @#PSW
		0o000240, // NOP, which the interrupt comes before
		0o000777, // BR .
	})
	tm.SetPSW(0o200)
	low.ringing = true
	tm.Step()
	expect(t, "PC at priority 4", tm.R[7], 0o1002)
	tm.Step()
	expect(t, "PC having come down to 3", tm.R[7], 0o1010)
	tm.Step()
	expect(t, "PC in the interrupt", tm.R[7], 0o2002)
	expect(t, "the status word in the interrupt", tm.PSW(), 0o340)
	v, _ = tm.Examine(0o774)
	expect(t, "where the interrupt returns to", v, 0o1010)
}

func TestInterruptOrder(t *testing.T) {
	fresh([]uint16{0o000777})    // BR .
	tm.Deposit(0o302, 0o200)     // the low bell's interrupt runs at its priority
	tm.Deposit(0o2000, 0o000777) // and stays: BR .
	tm.Deposit(0o3000, 0o000240) // the high bell's is NOP
	tm.Deposit(0o3002, 0o000002) // and RTI
	low.ringing = true
	high.ringing = true
	tm.Step()
	expect(t, "PC, both having rung", tm.R[7], 0o3002)
	if high.granted != 1 || low.granted != 0 {
		println("granted: the high bell", high.granted, "the low bell", low.granted)
		t.Fail()
	}
	tm.Step()
	expect(t, "PC, the high one served", tm.R[7], 0o1000)
	tm.Step()
	expect(t, "PC, the low one's turn", tm.R[7], 0o2000)
	if low.granted != 1 {
		println("the low bell was granted", low.granted, "times")
		t.Fail()
	}

	// And the high one interrupts the low one's.
	high.ringing = true
	tm.Step()
	expect(t, "PC, the high one having rung again", tm.R[7], 0o3002)
	expect(t, "SP, two interrupts deep", tm.R[6], 0o770)
	tm.Step()
	expect(t, "PC, back in the low one's", tm.R[7], 0o2000)
	expect(t, "the status word there", tm.PSW(), 0o200)
}

func TestWait(t *testing.T) {
	fresh([]uint16{
		0o000001, // WAIT
		0o000000, // HALT
	})
	tm.Deposit(0o2000, 0o000002) // RTI
	for i := 0; i < 3; i++ {
		if s := tm.Run(100); s != Waiting {
			println("the state of a machine that waits:", int(s))
			t.Fail()
		}
	}
	expect(t, "PC while waiting", tm.R[7], 0o1002)
	if tm.Count != 1 {
		println("instructions counted while waiting:", tm.Count)
		t.Fail()
	}

	low.ringing = true
	if s := tm.Run(100); s != Halted {
		println("the state after the interrupt:", int(s))
		t.Fail()
	}
	expect(t, "PC after the interrupt", tm.R[7], 0o1004)
	if tm.Count != 3 {
		println("instructions counted:", tm.Count)
		t.Fail()
	}
}

func TestReset(t *testing.T) {
	fresh([]uint16{0o000005}) // RESET
	was := low.resets
	low.reg = 0o1234
	tm.R[3] = 0o4321
	tm.Step()
	if low.resets != was+1 {
		println("RESET reset the bell", low.resets-was, "times")
		t.Fail()
	}
	expect(t, "R3 after RESET", tm.R[3], 0o4321)

	tm.SetPSW(0o140000) // and in user mode it does nothing
	tm.R[7] = 0o1000
	tm.Step()
	if low.resets != was+1 {
		println("RESET in user mode reset the bell")
		t.Fail()
	}
}

func TestFault(t *testing.T) {
	fresh([]uint16{0o104000}) // EMT
	tm.R[6] = 0o170000        // and nowhere to push to
	tm.Step()
	if s := tm.Step(); s != Faulted {
		println("the state with no stack for a trap:", int(s))
		t.Fail()
	}

	// Of the two words a trap pushes the first may be what cannot be written.
	// The second is then not written either.
	fresh([]uint16{0o104000})
	tm.Deposit(0o030, 0o2000)
	tm.Deposit(0o032, 0o340)
	tm.Deposit(0o157776, 0o123456)
	tm.R[6] = 0o160002
	tm.Step()
	if s := tm.Step(); s != Faulted {
		println("the state with half a stack for a trap:", int(s))
		t.Fail()
	}
	v, _ := tm.Examine(0o157776)
	expect(t, "the word below what could not be pushed", v, 0o123456)
	tm.Deposit(0o157776, 0)
}

// An interrupt whose vector lets another one in is followed by that one
// before an instruction is executed.
func TestInterruptAtOnce(t *testing.T) {
	fresh(nil)
	tm.Deposit(0o312, 0)         // the high bell's interrupt runs at priority 0
	tm.Deposit(0o3000, 0o000000) // and is HALT
	tm.Deposit(0o2000, 0o000240) // the low bell's is NOP
	low.ringing = true
	high.ringing = true
	if s := tm.Step(); s != Running {
		println("the state after two interrupts and an instruction:", int(s))
		t.Fail()
	}
	expect(t, "PC", tm.R[7], 0o2002)
	expect(t, "SP, two interrupts deep", tm.R[6], 0o770)
	if high.granted != 1 || low.granted != 1 {
		println("granted: the high bell", high.granted, "the low bell", low.granted)
		t.Fail()
	}
}

// What Run answers does not depend on how many instructions it was given.
func TestWaitState(t *testing.T) {
	for n := uint32(1); n <= 3; n++ {
		fresh([]uint16{0o000001}) // WAIT
		if s := tm.Run(n); s != Waiting {
			println("the state after WAIT, of", n, "instructions:", int(s))
			t.Fail()
		}
		expect(t, "PC after WAIT", tm.R[7], 0o1002)
		if tm.Count != 1 {
			println("instructions counted:", tm.Count)
			t.Fail()
		}
	}
}

// loop is a program with a subroutine, a stack and a trap in it, which runs
// for 5205 instructions and halts: four, four hundred times thirteen, and the
// HALT.
var loop = [...]uint16{
	0o012737, 0o001054, 0o000030, // 1000: MOV #1054, @#30
	0o005037, 0o000032, //           1006: CLR @#32
	0o012700, 0o000620, //           1012: MOV #400., R0
	0o005001,           //                     1016: CLR R1
	0o004767, 0o000010, //           1020: JSR PC, 1034
	0o104001, //                     1024: EMT 1
	0o077004, //                     1026: SOB R0, 1020
	0o000000, //                     1030: HALT
	0o000000, //
	0o010046, //                     1034: MOV R0, -(SP)
	0o060001, //                     1036: ADD R0, R1
	0o006301, //                     1040: ASL R1
	0o005501, //                     1042: ADC R1
	0o111602, //                     1044: MOVB (SP), R2
	0o074201, //                     1046: XOR R2, R1
	0o005726, //                     1050: TST (SP)+
	0o000207, //                     1052: RTS PC
	0o005203, //                     1054: INC R3
	0o000002, //                     1056: RTI
}

// A machine run in one go ends where one that is stepped ends.
func TestRunAsSteps(t *testing.T) {
	fresh(loop[:])
	if s := tm.Run(1 << 20); s != Halted {
		println("the state of the program that was run:", int(s))
		t.Fail()
	}
	count := tm.Count
	var r [8]uint16
	copy(r[:], tm.R[:])
	psw := tm.PSW()

	fresh(loop[:])
	s := Running
	for i := 0; i < 1<<20 && s == Running; i++ {
		s = tm.Step()
	}
	if s != Halted {
		println("the state of the program that was stepped:", int(s))
		t.Fail()
	}
	if tm.Count != count || count != 5205 {
		println("instructions: run", count, "stepped", tm.Count, "want 5205")
		t.Fail()
	}
	for i := 0; i < 8; i++ {
		if tm.R[i] != r[i] {
			printf("R%d: run %06o, stepped %06o\n", i, r[i], tm.R[i])
			t.Fail()
		}
	}
	expect(t, "the status word of the stepped one", tm.PSW(), psw)
	expect(t, "R3, which counts the traps", tm.R[3], 400)
}

// A device that moves data by itself reaches memory and nothing else, and is
// told where memory ends.
func TestTransfer(t *testing.T) {
	fresh(nil)
	var p [6]byte
	tm.Deposit(0o4000, 0o123456)
	tm.Deposit(0o4002, 0o000377)
	if n := tm.Fetch(0o4000, p[:4]); n != 4 || p[0] != 0o056 || p[1] != 0o247 || p[2] != 0o377 || p[3] != 0 {
		println("fetched", n, "bytes:", p[0], p[1], p[2], p[3])
		t.Fail()
	}
	p = [6]byte{1, 2, 3, 4, 5, 6}
	if n := tm.Store(0o4000, p[:5]); n != 4 {
		println("stored", n, "of five bytes")
		t.Fail()
	}
	v, _ := tm.Examine(0o4000)
	expect(t, "the first word stored", v, 0x0201)
	v, _ = tm.Examine(0o4002)
	expect(t, "the second", v, 0x0403)
	v, _ = tm.Examine(0o4004)
	expect(t, "the word after them", v, 0)

	// The last word of memory, the first of the I/O page, and where an
	// address of 18 bits has nothing.
	if n := tm.Store(IOPage-2, p[:]); n != 2 {
		println("stored", n, "bytes at the end of memory")
		t.Fail()
	}
	if n := tm.Fetch(IOPage-2, p[2:]); n != 2 || p[2] != 1 || p[3] != 2 {
		println("fetched", n, "bytes at the end of memory:", p[2], p[3])
		t.Fail()
	}
	if n := tm.Store(IOPage, p[:]) + tm.Fetch(0o600000, p[:]) + tm.Fetch(0o777560, p[:]); n != 0 {
		println("a transfer went where no memory is")
		t.Fail()
	}
}

// The machine comes as far as the instructions it executes, and as far as
// that when it waits.
func TestNow(t *testing.T) {
	fresh([]uint16{
		0o000240, // 1000: NOP
		0o000240, // 1002: NOP
		0o000777, // 1004: BR 1004
	})
	if tm.Now() != 0 {
		println("a machine that is reset has come", tm.Now(), "instructions far")
		t.Fail()
	}
	tm.Run(2)
	tm.Run(100)
	if tm.Now() != 102 || tm.Count != 102 {
		println("after 102 instructions the machine has come", tm.Now(), "far, and counted", tm.Count)
		t.Fail()
	}

	// A program that writes to a device, which has the devices asked after
	// the instruction that does: a device never sees the machine less far
	// than it has seen it.
	fresh([]uint16{
		0o005237, lowAt, // 1000: INC @#164000
		0o000775, //        1004: BR 1000
	})
	tm.Run(1000)
	if tm.Now() != 1000 || low.reg != 500 || low.back != 0 || low.seen < 990 {
		println("the machine has come", tm.Now(), "far, went back", low.back, "times, and was seen at", low.seen)
		t.Fail()
	}

	fresh([]uint16{0o000001}) // WAIT
	tm.Run(10)
	before := tm.Now()
	for i := 0; i < 10; i++ {
		tm.Run(10)
	}
	if tm.Count != 1 || tm.Now()-before < 10 {
		println("waiting, the machine has come", tm.Now()-before, "far, and counted", tm.Count)
		t.Fail()
	}
}

// mapped maps every page of both modes where its address says, as managed
// of the vectors does, and turns the unit on.
func mapped() {
	managed(&tm)
	tm.Deposit(statusReg, sr0Enable)
}

func TestMemoryManagement(t *testing.T) {
	// The console reads and writes memory as it is on the bus, whatever the
	// map says, and the registers of the unit above it.
	fresh(nil)
	mapped()
	tm.Deposit(0o172340, 0o200) // the kernel's page 0 begins at 20000 on the bus
	tm.Load(0o21000, []uint16{  // the program, at 1000 in the kernel's space
		0o013700, 0o001234, // MOV @#1234, R0
		0o012737, 0o004321, 0o001236, // MOV #4321, @#1236
		0o000000, // HALT
	})
	tm.Deposit(0o21234, 0o5555)
	tm.Deposit(0o1234, 0o6666)
	v, ok := tm.Examine(0o172340)
	if !ok || v != 0o200 {
		printf("the page address register reads %06o %t\n", v, ok)
		t.Fail()
	}
	v, ok = tm.Examine(statusReg)
	expect(t, "SR0 examined", v, sr0Enable)
	tm.Run(3)
	expect(t, "what the program read through the map", tm.R[0], 0o5555)
	v, _ = tm.Examine(0o21236)
	expect(t, "what it wrote through the map", v, 0o4321)
	v, _ = tm.Examine(0o1236)
	expect(t, "the word beneath, which the console sees as it is", v, 0)
	v, _ = tm.Examine(0o172300)
	expect(t, "the descriptor with the page written to", v, 0o77506)
	expect(t, "SR2, the address of the HALT", tm.sr2, 0o1012)

	// A trap from the user's space takes its vector from the kernel's, and
	// pushes on the kernel's stack in the kernel's space: the kernel's page
	// 0 is at 20000 on the bus, the user's where it says.
	fresh([]uint16{0o104000}) // EMT
	mapped()
	tm.Deposit(0o172340, 0o200)
	tm.Deposit(0o20030, 0o4000) // the vector, on the bus
	tm.Deposit(0o20032, 0o340)
	tm.Deposit(0o24000, 0)   // HALT, in the kernel's space at 4000
	tm.Deposit(0o30, 0o7777) // what the vector would be in the user's space
	tm.SetPSW(0o140000)
	tm.R[6] = 0o1700
	tm.sp[kernel] = 0o700
	tm.Run(2)
	expect(t, "PC in the handler", tm.R[7], 0o4002)
	expect(t, "the status word there", tm.PSW(), 0o030340)
	expect(t, "the kernel's stack pointer", tm.R[6], 0o674)
	v, _ = tm.Examine(0o20676)
	expect(t, "the status word pushed, on the bus", v, 0o140000)
	v, _ = tm.Examine(0o20674)
	expect(t, "the program counter pushed", v, 0o1002)
	v, _ = tm.Examine(0o676)
	expect(t, "the user's word beneath the kernel's stack", v, 0)

	// A machine is given at most what 18 bits reach, and one with none
	// answers nothing.
	if _, ok := crowded.Examine(0); ok || crowded.Deposit(0, 1) {
		println("a machine without memory took a word")
		t.Fail()
	}
}
