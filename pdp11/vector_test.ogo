import "testing"

// The processor against the vectors of vectors_test.ogo, which say what the
// 11/40 of SimH made of each instruction. scripts/vectors.py writes them and
// has the other half of what is said here about where a case's memory is and
// how its memory management is set up.

const (
	// region is where a case's memory is laid out: the first bytes of it, which
	// are compared word by word. Of the rest a case names what it touches.
	region = 0o4000

	// A case is this many numbers and then three for every word it names. Its
	// first three are these.
	caseSteps  = 0
	caseHalted = 1
	caseWords  = 2
	caseSize   = 3 + 2*stateSize

	// The machine before and after is R0 to R5 and then these.
	stateSP   = 6
	stateKSP  = 7
	stateUSP  = 8
	statePC   = 9
	statePSW  = 10
	stateSize = 11

	// maxFailures is how many cases are reported before the test gives up.
	maxFailures = 10
)

var stateNames = [stateSize]string{"R0", "R1", "R2", "R3", "R4", "R5", "SP", "KSP", "USP", "PC", "PSW"}

var (
	// vm is the machine the vectors run on, with as much memory as SimH was
	// given.
	vm       Machine
	vmMemory [28 * 1024]uint16

	// want is what a case's memory is to be after it.
	want [region / 2]uint16

	// current is the case being run, number says which it is, and good that
	// nothing has differed in it so far.
	current []uint16
	number  int
	good    bool

	// thorough says that all of memory is looked at after every case, for a
	// word written that the case does not name. The board has not the time
	// and looks once, after the last case. host_test.go sets it, which is Go
	// and is compiled where scripts/twin.sh runs the tests.
	thorough bool
)

// background is what the address a holds before a case puts its own there: the
// vectors of the traps, each leading to two NOPs, and nothing else. The
// vector of the memory management, 250, leads there too.
func background(a uint16) uint16 {
	switch {
	case a >= 0o4 && a < 0o40:
		if a&2 == 0 {
			return 0o3400 + a
		}
		return 0o340 + a>>2
	case a >= 0o3404 && a < 0o3440:
		return 0o000240
	case a == 0o250:
		return 0o3650
	case a == 0o252:
		return 0o352
	case a >= 0o3650 && a < 0o3670:
		return 0o000240
	}
	return 0
}

// managed is what the registers of the memory management hold before a case
// sets its own: every page of both modes where the address says it is, the
// eighth on the I/O page, and the unit off. A case names what it changes,
// and what changes.
func managed(vm *Machine) {
	for mode := uint16(kernel); mode <= user; mode += user {
		block := uint16(kernelPages)
		if mode == user {
			block = userPages
		}
		for n := uint16(0); n < 8; n++ {
			par := n << 7
			if n == 7 {
				par = 0o7600
			}
			vm.Deposit(block+0o40+2*n, par)
			vm.Deposit(block+2*n, 0o77406)
		}
	}
	vm.Deposit(statusReg, 0)
}

func TestVectors(t *testing.T) {
	vm.Memory(vmMemory[:])
	failures := 0
	number = 0
	for v := vectors[:]; len(v) != 0; number++ {
		size := caseSize + 3*int(v[caseWords])
		current = v[:size]
		runCase()
		if thorough && !untouched() {
			good = false
		}
		if !good {
			t.Fail()
			failures++
			if failures == maxFailures {
				println("and there may be more")
				return
			}
		}
		v = v[size:]
	}
	if !untouched() {
		t.Fail()
	}
	println(number, "vectors")
}

// untouched reports whether memory past the region holds nothing, which is
// what the cases leave it holding. It says what it finds there and removes it.
func untouched() bool {
	ok := true
	for i := region / 2; i < len(vm.mem); i++ {
		if vm.mem[i] != 0 {
			printf("vector %d or one before it: memory at %06o %06o, which no case names\n",
				number, 2*i, vm.mem[i])
			vm.mem[i] = 0
			ok = false
		}
	}
	return ok
}

// runCase runs the current case and leaves in good whether the machine came
// out of it as the reference did, having said what differs if it did not.
// A word a case names in the I/O page is a register of the memory
// management, which is deposited and examined as the console does.
func runCase() {
	before := current[caseSize-2*stateSize : caseSize-stateSize]
	after := current[caseSize-stateSize : caseSize]
	words := current[caseSize:]

	vm.Reset()
	managed(&vm)
	for a := uint16(0); a < region; a += 2 {
		v := background(a)
		vm.mem[a>>1] = v
		want[a>>1] = v
	}
	for i := 0; i < len(words); i += 3 {
		a := words[i]
		switch {
		case a >= IOPage:
			vm.Deposit(a, words[i+1])
		case a < region:
			vm.mem[a>>1] = words[i+1]
			want[a>>1] = words[i+2]
		default:
			vm.mem[a>>1] = words[i+1]
		}
	}

	copy(vm.R[:6], before)
	vm.sp[kernel] = before[stateKSP]
	vm.sp[user] = before[stateUSP]
	vm.psw = before[statePSW]
	vm.space = vm.psw >> 14
	vm.R[6] = before[stateSP]
	vm.R[7] = before[statePC]

	doing := Running
	steps := uint32(0)
	for ; steps < uint32(current[caseSteps]) && doing == Running; steps++ {
		doing = vm.Step()
	}

	good = true
	if halted := current[caseHalted] != 0; halted != (doing == Halted) {
		differs()
		println("\tthe state is", int(doing), "and the reference halted:", halted)
	}
	if vm.Count != steps {
		differs()
		println("\tinstructions counted:", vm.Count, "in", steps, "steps")
	}
	for i := 0; i < stateSize; i++ {
		if got := state(i); got != after[i] {
			differs()
			printf("\t%s %06o, want %06o\n", stateNames[i], got, after[i])
		}
	}
	for a := 0; a < region; a += 2 {
		if got := vm.mem[a>>1]; got != want[a>>1] {
			differs()
			printf("\tmemory at %06o %06o, want %06o\n", a, got, want[a>>1])
		}
	}
	for i := 0; i < len(words); i += 3 {
		switch a := words[i]; {
		case a >= IOPage:
			if got, _ := vm.Examine(a); got != words[i+2] {
				differs()
				printf("\tregister %06o %06o, want %06o\n", a, got, words[i+2])
			}
		case a >= region:
			if got := vm.mem[a>>1]; got != words[i+2] {
				differs()
				printf("\tmemory at %06o %06o, want %06o\n", a, got, words[i+2])
			}
			vm.mem[a>>1] = 0 // as the next case expects to find it
		}
	}
}

// state answers the part of the machine that a case has at i.
func state(i int) uint16 {
	switch i {
	case stateSP:
		return vm.R[6]
	case stateKSP:
		return stack(kernel)
	case stateUSP:
		return stack(user)
	case statePC:
		return vm.R[7]
	case statePSW:
		return vm.psw
	}
	return vm.R[i]
}

// stack answers the stack pointer of a mode.
func stack(mode uint16) uint16 {
	if vm.psw>>14 == mode {
		return vm.R[6]
	}
	return vm.sp[mode]
}

// differs notes that the current case is not good, and says which case it is
// if that is news.
func differs() {
	if !good {
		return
	}
	good = false
	words := current[caseSize:]
	pc := current[caseSize-2*stateSize+statePC]
	ir := background(pc)
	for i := 0; i < len(words); i += 3 {
		if words[i] == pc {
			ir = words[i+1]
		}
	}
	printf("vector %d, instruction %06o at %06o, status word %06o, %d steps\n",
		number, ir, pc, current[caseSize-stateSize-1], current[caseSteps])
}
