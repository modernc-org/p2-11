// The bus: memory, and in the I/O page the registers of the processor and of
// the devices. An address of the processor's is relocated onto the bus by
// the memory management when that is on, and is the bus's own otherwise, the
// I/O page then being the top of what 16 bits reach.
//
// An access that cannot be made does not stop the instruction where it stands,
// there being nothing in the language to unwind with. It requests a trap and
// reads as zero, and the instruction asks whether one of the aborts is
// requested before it changes anything, which is what leaves the machine as a
// real one is left.
//
// Reading and writing memory is most of what the machine does, and a call
// costs more here than what these functions do. So each is one function with
// memory first, and what is rare is what it calls.

// read reads what is at the address a: a word, or a byte if size is 1. The
// cycle is dati for a read and datip for one the instruction will write
// back, which a page must admit writing for, as the abort comes before the
// read on the real machine and before the instruction has done anything.
func (m *Machine) read(a, size, cycle uint16) uint16 {
	if size == 2 && a&1 != 0 {
		m.traps |= trapOdd
		return 0
	}
	pa := uint32(a)
	if m.sr0&sr0Enable == 0 {
		if a >= IOPage {
			return m.readIO(a, size)
		}
	} else {
		p := &m.pages[m.space][a>>13]
		d := a & pageOffset
		if d < p.low || d > p.high || p.may&cycle != cycle {
			m.abort(a, cycle)
			return 0
		}
		pa = p.base + uint32(d)
		if pa >= ioBase {
			return m.readIO(uint16(pa-ioBase)+IOPage, size)
		}
	}
	i := pa >> 1
	if i >= uint32(len(m.mem)) {
		m.traps |= trapTimeout
		return 0
	}
	if size == 1 {
		if a&1 != 0 {
			return m.mem[i] >> 8
		}
		return m.mem[i] & 0xff
	}
	return m.mem[i]
}

// write writes v at the address a: a word, or a byte if size is 1, and then
// nothing beside the byte.
func (m *Machine) write(a, size, v uint16) {
	if size == 2 && a&1 != 0 {
		m.traps |= trapOdd
		return
	}
	pa := uint32(a)
	if m.sr0&sr0Enable == 0 {
		if a >= IOPage {
			m.writeIO(a, size, v)
			return
		}
	} else {
		p := &m.pages[m.space][a>>13]
		d := a & pageOffset
		if d < p.low || d > p.high || p.may&dato != dato {
			m.abort(a, dato)
			return
		}
		if p.may&written == 0 {
			p.may |= written
			m.pdr[m.space][a>>13] |= pdrWritten
		}
		pa = p.base + uint32(d)
		if pa >= ioBase {
			m.writeIO(uint16(pa-ioBase)+IOPage, size, v)
			return
		}
	}
	i := pa >> 1
	if i >= uint32(len(m.mem)) {
		m.traps |= trapTimeout
		return
	}
	if size == 1 {
		if a&1 != 0 {
			m.mem[i] = m.mem[i]&0x00ff | v<<8
			return
		}
		m.mem[i] = m.mem[i]&0xff00 | v&0xff
		return
	}
	m.mem[i] = v
}

// device answers the device that has the register at a, or nil after
// requesting the trap a bus time-out ends in.
func (m *Machine) device(a uint16) Device {
	if a >= IOPage {
		if i := m.owner[(a-IOPage)>>1]; i != 0 {
			m.traps |= attention // what it asks for may be about to change
			return m.devices[i-1].dev
		}
	}
	m.traps |= trapTimeout
	return nil
}

// readIO reads what is not memory. Either byte of a register is read by
// reading the register.
func (m *Machine) readIO(a, size uint16) uint16 {
	if size == 2 && a&1 != 0 {
		m.traps |= trapOdd
		return 0
	}
	var w uint16
	switch r := a &^ 1; {
	case r == StatusWord:
		w = m.psw
	case r == SwitchRegister:
		w = m.Switches
	case r == statusReg:
		w = m.sr0
	case r == addressReg:
		w = m.sr2
	case r>>6 == kernelPages>>6 || r>>6 == userPages>>6:
		w = m.readPage(r)
	default:
		d := m.device(a)
		if d == nil {
			return 0
		}
		w = d.Read(r)
	}
	switch {
	case size == 2:
		return w
	case a&1 != 0:
		return w >> 8
	}
	return w & 0xff
}

// writeIO writes what is not memory. A register is told which of its bits are
// written, all of them for a word and one half of them for a byte.
func (m *Machine) writeIO(a, size, v uint16) {
	mask := uint16(0xffff)
	if size == 1 {
		mask = 0x00ff
		v &= 0xff
		if a&1 != 0 {
			mask = 0xff00
			v <<= 8
		}
	} else if a&1 != 0 {
		m.traps |= trapOdd
		return
	}
	switch r := a &^ 1; {
	case r == StatusWord:
		// A program changes everything in the status word but the trace bit,
		// which only a trap and a return from one change.
		m.setPSW((m.psw&^mask|v&mask)&^flagT | m.psw&flagT)
	case r == SwitchRegister:
		m.Display = m.Display&^mask | v&mask
	case r == statusReg:
		// The error bits, the maintenance bit and the enable bit are the
		// program's to write; the page and the mode of an abort are not.
		m.sr0 = m.sr0&^(mask&sr0Writable) | v&mask&sr0Writable
		m.traps |= attention // what the fetch looks at has changed
	case r == addressReg:
	case r>>6 == kernelPages>>6 || r>>6 == userPages>>6:
		m.writePage(r, v, mask)
		m.traps |= attention
	default:
		if d := m.device(a); d != nil {
			d.Write(r, v, mask)
		}
	}
}

// setPSW makes v the status word. A change of mode changes the stack pointer,
// each mode having its own, and the pages an access goes through.
func (m *Machine) setPSW(v uint16) {
	v &= statusBits
	if now, next := m.psw>>14, v>>14; now != next {
		m.sp[now] = m.R[6]
		m.R[6] = m.sp[next]
	}
	m.psw = v
	m.space = v >> 14
	m.traps |= attention // the priority may have come down to below a request
}
